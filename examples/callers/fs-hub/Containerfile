# Copy to fs-hub/Containerfile. The build context is prepared by fs-release and contains
# amd64/ and arm64/, each holding the release binary (and licence files). Do not use RUN steps
# that need the target architecture unless QEMU emulation is acceptable (it is set up, but slow).
# The base must be at least as new as the build runner (glibc of ubuntu-24.04).
FROM docker.io/library/ubuntu:24.04
ARG TARGETARCH
COPY ${TARGETARCH}/fs-hub /usr/local/bin/fs-hub
COPY ${TARGETARCH}/LICENSE-MIT ${TARGETARCH}/LICENSE-APACHE /licenses/
USER 65534
ENTRYPOINT ["/usr/local/bin/fs-hub"]
